# 네이버 클라우드 플랫폼 · Maps JavaScript API 클라이언트 ID
VITE_NAVER_MAP_CLIENT_ID=

# Directions API (차량 /map-direction/v1/driving) — Client Secret은 서버에서만 사용 (VITE_ 붙이지 않음)
# Maps 애플리케이션에서 Directions 권한을 켠 뒤 동일 앱의 Client ID·Secret을 넣습니다.
NCP_MAP_CLIENT_ID=
NCP_MAP_CLIENT_SECRET=

# GitHub Pages 프로젝트 사이트만 해당 (저장소 이름이 경로로 붙는 경우)
# 예: 저장소가 MyRepo 이면 https://user.github.io/MyRepo/
VITE_BASE_URL=/
